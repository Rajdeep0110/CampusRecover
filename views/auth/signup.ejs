<div class="signup-page">

    <div class="signup-container">

        <div class="signup-content">

            <div class="signup-heading">
                <p class="signup-eyebrow">JOIN OUR STUDENT COMMUNITY</p>

                <% if (typeof step !== "undefined" && step === "details") { %>
                    <h1>
                        Complete Your Account<br>
                        <span>Set Up Your Profile</span>
                    </h1>

                    <p class="signup-description">
                        Your email address has been verified! Choose your username and password
                        to complete your CampusRecover account.
                    </p>
                <% } else { %>
                    <h1>
                        Create Your Account<br>
                        <span>Start Making a Safer Campus</span>
                    </h1>

                    <p class="signup-description">
                        Sign up to report, search, and help fellow students recover lost and found
                        items across your campus.
                    </p>
                <% } %>
            </div>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="login-error" style="color: #ff3333; margin-bottom: 15px; font-size: 15px;">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof step !== "undefined" && step === "details") { %>
                <!-- STEP 2: DETAILS (Only accessible after OTP has been successfully verified) -->
                <form action="/signup" method="POST" class="signup-form">

                    <div class="signup-field">
                        <label for="email">
                            Email
                            <span style="color: #16a34a; font-size: 13px; font-weight: 600; margin-left: 6px;">
                                <i class="bi bi-patch-check-fill"></i> Verified
                            </span>
                        </label>

                        <div class="signup-input" style="background: #f1f5f9;">
                            <i class="bi bi-envelope-check" style="color: #16a34a;"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="<%= typeof verifiedEmail !== 'undefined' ? verifiedEmail : '' %>"
                                readonly
                                style="color: #475569; cursor: not-allowed;"
                                required
                            >
                        </div>

                        <div style="margin-top: 6px; font-size: 13px;">
                            <a href="/signup?reset=true" style="color: #64748b; text-decoration: none;">Use a different email</a>
                        </div>
                    </div>

                    <div class="signup-field">
                        <label for="name">Username</label>

                        <div class="signup-input">
                            <i class="bi bi-person"></i>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter your username"
                                required
                                autofocus
                            >
                        </div>
                    </div>

                    <div class="signup-field">
                        <label for="password">Password</label>

                        <div class="signup-input">
                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Create a password"
                                required
                            >

                            <i class="bi bi-eye toggle-password" style="cursor: pointer;"></i>
                        </div>
                    </div>

                    <button type="submit" class="signup-submit">
                        Complete Sign Up <span>→</span>
                    </button>

                </form>
            <% } else { %>
                <!-- STEP 1: EMAIL (Enter Gmail to receive verification OTP) -->
                <form action="/signup" method="POST" class="signup-form">

                    <div class="signup-field">
                        <label for="email">Email</label>

                        <div class="signup-input">
                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="<%= typeof email !== 'undefined' ? email : '' %>"
                                placeholder="Enter your email"
                                required
                                autofocus
                            >
                        </div>
                    </div>

                    <button type="submit" class="signup-submit">
                        Send Verification Code <span>→</span>
                    </button>

                </form>
            <% } %>

            <p class="signup-login">
                Already have an account?
                <a href="/login">Log In</a>
            </p>

        </div>


        <div class="signup-visual">

            <div class="signup-image">
                <img
                    src="/images/hero-campus.jpg"
                    alt="CampusRecover"
                >
            </div>

            <div class="signup-benefits">

                <div class="signup-benefit">
                    <div class="benefit-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Student Community</h3>
                    <p>Helping each other</p>
                </div>

                <div class="signup-benefit">
                    <div class="benefit-icon">
                        <i class="bi bi-shield-fill"></i>
                    </div>

                    <h3>Safer Campus</h3>
                    <p>Belonging starts here</p>
                </div>

                <div class="signup-benefit">
                    <div class="benefit-icon heart">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                    <h3>Make a Difference</h3>
                    <p>Small actions, big impact</p>
                </div>

            </div>

        </div>

    </div>

</div>

<script>
    document.querySelectorAll(".toggle-password").forEach(function(icon) {
        icon.addEventListener("click", function() {
            var input = this.parentElement.querySelector("input[name='password']");
            if (input) {
                if (input.type === "password") {
                    input.type = "text";
                    this.classList.remove("bi-eye");
                    this.classList.add("bi-eye-slash");
                } else {
                    input.type = "password";
                    this.classList.remove("bi-eye-slash");
                    this.classList.add("bi-eye");
                }
            }
        });
    });

    // Step 1: Manage verification code submit and loading state
    (function() {
        var emailForm = document.querySelector(".signup-form");
        if (!emailForm) return;

        var submitBtn = emailForm.querySelector(".signup-submit");
        var emailInput = emailForm.querySelector("input[name='email']");
        var passwordInput = emailForm.querySelector("input[name='password']");

        // Only handle Step 1 (email entry), not Step 2 (account details completion)
        if (submitBtn && emailInput && !passwordInput) {
            emailForm.addEventListener("submit", async function(e) {
                e.preventDefault();

                var originalBtnHtml = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.style.opacity = "0.75";
                submitBtn.style.cursor = "not-allowed";
                submitBtn.innerHTML = 'Sending Code... <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem; border-width: 0.15em; margin-left: 6px; vertical-align: middle;"></span>';

                var errorBox = document.querySelector(".login-error");
                if (errorBox) {
                    errorBox.style.display = "none";
                }

                function resetButton() {
                    submitBtn.disabled = false;
                    submitBtn.style.opacity = "";
                    submitBtn.style.cursor = "pointer";
                    submitBtn.innerHTML = originalBtnHtml;
                }

                function showError(msg) {
                    if (!errorBox) {
                        errorBox = document.createElement("div");
                        errorBox.className = "login-error";
                        errorBox.style.cssText = "color: #ff3333; margin-bottom: 15px; font-size: 15px;";
                        emailForm.parentNode.insertBefore(errorBox, emailForm);
                    }
                    errorBox.textContent = msg;
                    errorBox.style.display = "block";
                }

                try {
                    var formData = new URLSearchParams(new FormData(emailForm));
                    var response = await fetch("/signup", {
                        method: "POST",
                        headers: {
                            "Accept": "application/json",
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: formData.toString()
                    });

                    var data = await response.json().catch(function() { return null; });

                    if (response.ok && data && data.success && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        var message = (data && data.error) ? data.error : "Unable to send verification email. Please check your email address and try again.";
                        showError(message);
                        resetButton();
                    }
                } catch (err) {
                    showError("Unable to connect to the server. Please check your internet connection and try again.");
                    resetButton();
                }
            });
        }
    })();
</script>