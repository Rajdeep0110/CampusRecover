<div class="login-page">

    <div class="login-container">

        <!-- Login Content -->

        <div class="login-content">

            <p class="login-eyebrow">
                WELCOME BACK TO OUR COMMUNITY
            </p>

            <h1>
                Welcome Back
                <br>
                <span>Let's Recover Together</span>
            </h1>

            <p class="login-description">
                Log in to report lost items, search found belongings, and help
                fellow students reconnect with what matters.
            </p>

            <form action="/login" method="POST" class="login-form">

                <div class="login-field">

                    <label for="email">
                        Email
                    </label>

                    <div class="login-input">

                        <i class="bi bi-envelope"></i>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                        >

                    </div>

                </div>


                <div class="login-field">

                    <label for="password">
                        Password
                    </label>

                    <div class="login-input">

                        <i class="bi bi-lock"></i>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            required
                        >

                        <i class="bi bi-eye"></i>

                    </div>

                </div>


                <% if (typeof error !== "undefined" && error) { %>
                    <div class="login-error">
                        <%= error %>
                    </div>
                <% } %>


                <div class="login-options">

                    <label class="remember-me">

                        <input
                            type="checkbox"
                            name="remember"
                        >

                        <span>Remember me</span>

                    </label>

                    <a
                        href="/forgot-password"
                        class="forgot-password"
                    >
                        Forgot password?
                    </a>

                </div>


                <button
                    type="submit"
                    class="login-submit"
                >
                    Log In
                    <span>→</span>
                </button>


                <div class="login-divider">

                    <span></span>

                    <p>OR</p>

                    <span></span>

                </div>


                <a
                    href="/auth/google"
                    class="google-login"
                >
                    <svg class="google-icon" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M21.35 12.27c0-.79-.07-1.55-.22-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42z"/>
                        <path fill="#34A853" d="M12 21.75c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.53A9.75 9.75 0 0 0 12 21.75z"/>
                        <path fill="#FBBC05" d="M6.54 13.83A5.86 5.86 0 0 1 6.24 12c0-.64.11-1.26.3-1.83V7.64H3.3A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.06 1.05 4.36l3.24-2.53z"/>
                        <path fill="#EA4335" d="M12 6.14c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 3.23 14.63 2.25 12 2.25a9.75 9.75 0 0 0-8.7 5.39l3.24 2.53C7.31 7.86 9.46 6.14 12 6.14z"/>
                    </svg>

                    Continue with Google

                </a>


                <p class="login-signup">
                    Don't have an account?
                    <a href="/signup">
                        Sign Up
                    </a>
                </p>

            </form>

        </div>


        <!-- Login Visual -->

        <div class="login-visual">

            <div class="login-image">

                <img
                    src="/images/hero-campus.jpg"
                    alt="Campus community"
                >

                <div class="login-image-overlay">

                    <h2>
                        Lost today,<br>
                        found tomorrow.
                    </h2>

                    <p>
                        Because every item has a story,<br>
                        and every student matters.
                    </p>

                </div>

            </div>


            <div class="login-benefits">

                <div class="login-benefit">

                    <div class="login-benefit-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3>
                        Find What Matters
                    </h3>

                    <p>
                        Search reported items
                        quickly and easily
                    </p>

                </div>


                <div class="login-benefit">

                    <div class="login-benefit-icon safer">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h3>
                        Safer Campus
                    </h3>

                    <p>
                        Helping belongings
                        return home
                    </p>

                </div>


                <div class="login-benefit">

                    <div class="login-benefit-icon heart">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                    <h3>
                        Make a Difference
                    </h3>

                    <p>
                        Small actions,
                        big impact
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>