<div class="reset-page">

    <div class="reset-container">

        <div class="reset-content">

            <div class="reset-topbar">

                <a href="/items" class="reset-brand">
                    <span class="reset-brand-icon">
                        <i class="bi bi-backpack-fill"></i>
                    </span>

                    <span>
                        Campus<span>Recover</span>
                    </span>
                </a>

                <a href="/items" class="reset-home-link">
                    <i class="bi bi-house"></i>
                    Back to Home
                </a>

            </div>

            <div class="reset-form-section">

                <div class="reset-eyebrow">
                    RESET PASSWORD
                </div>

                <h1>
                    Set a New
                    <span>Password</span>
                </h1>

                <p class="reset-description">
                    Choose a strong password to keep your account safe
                    and secure.
                </p>

                <form
                    action="/reset-password/<%= token %>"
                    method="POST"
                    class="reset-form"
                >

                    <div class="reset-field">

                        <label for="password">
                            New Password
                        </label>

                        <div class="reset-input">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter new password"
                                required
                            >

                        </div>

                    </div>

                    <div class="reset-field">

                        <label for="confirmPassword">
                            Confirm New Password
                        </label>

                        <div class="reset-input">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="Confirm new password"
                                required
                            >

                        </div>

                    </div>

                    <div class="reset-tips">

                        <div class="reset-tip-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <strong>Password Tips</strong>

                            <p>
                                <i class="bi bi-check-circle-fill"></i>
                                Use at least 8 characters
                            </p>

                            <p>
                                <i class="bi bi-check-circle-fill"></i>
                                Include letters, numbers and a special character
                            </p>

                            <p>
                                <i class="bi bi-check-circle-fill"></i>
                                Avoid using your name or email
                            </p>

                        </div>

                    </div>

                    <button type="submit" class="reset-submit">
                        Reset Password
                        <span>→</span>
                    </button>

                </form>

                <div class="reset-divider">
                    <span></span>
                    <strong>OR</strong>
                    <span></span>
                </div>

                <a href="/login" class="reset-login">
                    <i class="bi bi-arrow-left"></i>
                    Back to Login
                </a>

            </div>

        </div>

        <div class="reset-visual">

            <div class="reset-image">

                <img
                    src="/images/forgot-password-campus.jpg"
                    alt="CampusRecover campus"
                >

                <div class="reset-overlay">

                    <h2>
                        Stronger<br>
                        Together
                    </h2>

                    <div class="reset-line"></div>

                    <p>
                        Your account. Your community.
                        Let's keep it safe so you can
                        continue your journey with
                        CampusRecover.
                    </p>

                    <div class="reset-features">

                        <div class="reset-feature">

                            <div class="reset-feature-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>

                            <span>
                                Your data<br>
                                stays secure
                            </span>

                        </div>

                        <div class="reset-feature">

                            <div class="reset-feature-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <span>
                                A safer campus<br>
                                for everyone
                            </span>

                        </div>

                        <div class="reset-feature">

                            <div class="reset-feature-icon">
                                <i class="bi bi-heart-fill"></i>
                            </div>

                            <span>
                                Because you<br>
                                belong here
                            </span>

                        </div>

                    </div>

                    <div class="reset-quote">
                        "New beginnings lead<br>
                        to brighter tomorrows."
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>