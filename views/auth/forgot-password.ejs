<div class="forgot-page">

    <div class="forgot-container">

        <!-- LEFT SIDE -->
        <div class="forgot-content">

            <div class="forgot-topbar">

                <a href="/items" class="forgot-brand">
                    <span class="forgot-brand-icon">
                        <i class="bi bi-backpack-fill"></i>
                    </span>

                    <span>
                        Campus<span>Recover</span>
                    </span>
                </a>

                <a href="/items" class="forgot-home-link">
                    <i class="bi bi-house"></i>
                    Back to Home
                </a>

            </div>


            <div class="forgot-form-section">

                <div class="forgot-eyebrow">
                    ACCOUNT RECOVERY
                </div>

                <h1>
                    Forgot Your
                    <span>Password?</span>
                </h1>

                <p class="forgot-description">
                    No worries! Enter your registered email address and
                    we'll send you a link to reset your password and get
                    back to CampusRecover.
                </p>


                <form action="/forgot-password" method="POST" class="forgot-form">

                    <div class="forgot-field">

                        <label for="email">
                            Email
                        </label>

                        <div class="forgot-input">

                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter your email address"
                                required
                            >

                        </div>

                    </div>


                    <button type="submit" class="forgot-submit">
                        Send Reset Link
                        <span>→</span>
                    </button>

                </form>


                <div class="forgot-security">

                    <i class="bi bi-lock-fill"></i>

                    <span>
                        We'll never share your email with anyone else.
                    </span>

                </div>


                <div class="forgot-divider">
                    <span></span>
                    <strong>OR</strong>
                    <span></span>
                </div>


                <a href="/login" class="forgot-login">
                    <i class="bi bi-arrow-left"></i>
                    Back to Login
                </a>


                <div class="forgot-tip">

                    <div class="forgot-tip-icon">
                        <i class="bi bi-lightbulb-fill"></i>
                    </div>

                    <div>
                        <strong>Tip:</strong>
                        Check your spam folder if you don't see the email
                        in your inbox.
                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="forgot-visual">

            <div class="forgot-image">

                <img
                    src="/images/forgot-password-campus.jpg"
                    alt="CampusRecover account recovery"
                >

            </div>

        </div>

    </div>

</div>