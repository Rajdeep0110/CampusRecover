<section class="edit-page">

    <div class="container">

        <div class="edit-header">

            <div>
                <span class="edit-label">MANAGE REPORTED ITEM</span>

                <h1>
                    Edit <span>Item</span>
                </h1>

                <p>
                    Update the details of this lost or found item.
                </p>
            </div>

            <div class="edit-header-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

        </div>


        <div class="edit-card">

            <form action="/items/<%= item._id %>/update" method="POST">

                <!-- Item Title -->
                <div class="mb-3">

                    <label for="title" class="form-label">
                        Item Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        class="form-control"
                        value="<%= formData && formData.title !== undefined ? formData.title : item.title %>"
                    >

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label for="description" class="form-label">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        class="form-control"
                        rows="4"
                    ><%= formData && formData.description !== undefined ? formData.description : item.description %></textarea>

                </div>


                <!-- Category -->
                <div class="mb-3">

                    <label for="category" class="form-label">
                        Category
                    </label>

                    <input
                        type="text"
                        id="category"
                        name="category"
                        class="form-control"
                        value="<%= formData && formData.category !== undefined ? formData.category : item.category %>"
                    >

                </div>


                <!-- Type -->
                <div class="mb-3">

                    <label for="type" class="form-label">
                        Status
                    </label>

                    <select
                        id="type"
                        name="type"
                        class="form-select"
                    >

                        <option
                            value="Lost"
                            <%= (formData && formData.type !== undefined ? formData.type : item.type) === "Lost" ? "selected" : "" %>
                        >
                            Lost
                        </option>

                        <option
                            value="Found"
                            <%= (formData && formData.type !== undefined ? formData.type : item.type) === "Found" ? "selected" : "" %>
                        >
                            Found
                        </option>

                    </select>

                </div>


                <!-- Location -->
                <div class="mb-3">

                    <label for="location" class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        class="form-control"
                        value="<%= formData && formData.location !== undefined ? formData.location : item.location %>"
                    >

                </div>


                <!-- Date -->
                <div class="mb-3">

                    <label for="date" class="form-label">
                        Date
                    </label>

                    <input
                        type="date"
                        id="date"
                        name="date"
                        class="form-control"
                        value="<%= formData && formData.date !== undefined ? formData.date : item.date.toISOString().split('T')[0] %>"
                    >

                </div>


                <% if (error) { %>

                    <div class="edit-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <%= error %>
                    </div>

                <% } %>


                <!-- Buttons -->
                <div class="edit-actions">

                    <button type="submit" class="update-btn">
                        <i class="bi bi-check2-circle"></i>
                        Update Item
                    </button>

                    <a
                        href="/items/<%= item._id %>"
                        class="back-details-btn"
                    >
                        <i class="bi bi-arrow-left"></i>
                        Back to Details
                    </a>

                </div>

            </form>

        </div>

    </div>

</section>