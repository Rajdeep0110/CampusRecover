<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lost & Found Items</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container mt-5">

        <h1 class="mb-4">Lost & Found Items</h1>

        <div class="row">

            <% for (let item of items) { %>

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                <%= item.title %>
                            </h5>

                            <p class="card-text">
                                <%= item.description %>
                            </p>

                            <p class="mb-1">
                                <strong>Category:</strong>
                                <%= item.category %>
                            </p>

                            <p class="mb-1">
                                <strong>Type:</strong>
                                <%= item.type %>
                            </p>

                            <p class="mb-1">
                                <strong>Location:</strong>
                                <%= item.location %>
                            </p>

                            <p class="mb-0">
                                <strong>Date:</strong>
                                <%= item.date.toDateString() %>
                            </p>

                        </div>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</body>
</html>