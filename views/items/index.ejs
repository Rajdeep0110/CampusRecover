<section class="items-page">

    <div class="container">

        <!-- Page Header -->

        <div class="items-page-header">

            <div>
                <span class="items-label">ITEMS ACROSS YOUR CAMPUS</span>

                <h1>
                    Lost & Found <span>Items</span>
                </h1>

                <p>
                    Browse reported lost and found items from your campus.
                    Together, we can reunite them with their owners.
                </p>
            </div>

            <div class="items-header-icon">
                <i class="bi bi-backpack-fill"></i>
            </div>

        </div>


        <!-- Items Count -->

        <div class="items-toolbar">

            <strong>
                <%= items.length %>
                <%= items.length === 1 ? "item" : "items" %>
                found
            </strong>

        </div>


        <!-- Items -->

        <div class="row g-3">

            <% if (items && items.length > 0) { %>

                <% items.forEach(item => { %>

                    <% const category = item.category.trim().toLowerCase(); %>

                    <div class="col-12 col-sm-6 col-lg-3">

                        <div class="item-card">

                            <!-- Image -->

                            <div class="item-top">

                                <% if (item.image) { %>

                                    <img
                                        src="<%= item.image %>"
                                        alt="<%= item.title %>"
                                    >

                                <% } else if (category === "bag") { %>

                                    <img
                                        src="/images/backpack.jpg"
                                        alt="Backpack"
                                    >

                                <% } else if (category === "books") { %>

                                    <img
                                        src="/images/notebook.jpg"
                                        alt="Notebook"
                                    >

                                <% } else if (category === "wallet") { %>

                                    <img
                                        src="/images/wallet.jpg"
                                        alt="Wallet"
                                    >

                                <% } else { %>

                                    <i class="bi bi-box item-icon"></i>

                                <% } %>


                                <!-- Status -->

                                <% if (item.type === "Lost") { %>

                                    <span class="status-badge lost-badge">
                                        Lost
                                    </span>

                                <% } else { %>

                                    <span class="status-badge found-badge">
                                        Found
                                    </span>

                                <% } %>

                            </div>


                            <!-- Content -->

                            <div class="item-content">

                                <div class="item-category">

                                    <% if (category === "bag") { %>

                                        <i class="bi bi-backpack-fill"></i>

                                    <% } else if (category === "books") { %>

                                        <i class="bi bi-book-fill"></i>

                                    <% } else if (category === "wallet") { %>

                                        <i class="bi bi-wallet-fill"></i>

                                    <% } else { %>

                                        <i class="bi bi-box"></i>

                                    <% } %>

                                    <span>
                                        <%= item.category %>
                                    </span>

                                </div>


                                <h3 class="item-title">
                                    <%= item.title %>
                                </h3>


                                <p class="item-description">
                                    <%= item.description %>
                                </p>


                                <div class="item-info">

                                    <span>
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <%= item.location %>
                                    </span>

                                    <span>
                                        <i class="bi bi-calendar3"></i>
                                        <%= new Date(item.date).toDateString() %>
                                    </span>

                                </div>


                                <a
                                    href="/items/<%= item._id %>"
                                    class="details-btn"
                                >
                                    View Details
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-12">

                    <div class="empty-state">

                        <i class="bi bi-inbox empty-icon"></i>

                        <h3>
                            No items found
                        </h3>

                        <p>
                            Try another search or report a new item.
                        </p>

                        <a
                            href="/items/new"
                            class="btn btn-primary"
                        >
                            Report an Item
                        </a>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</section>