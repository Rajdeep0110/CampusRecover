<div class="details-page">

    <div class="container">

        <div class="details-top">
            <a href="/items" class="back-items">
                <i class="bi bi-arrow-left"></i>
                Back to Items
            </a>

            <span class="details-message">
                Small things matter
            </span>
        </div>

        <div class="details-card">

            <div class="details-image-section">

                <div class="details-image">
                    <% if (item.image) { %>
                        <img src="<%= item.image %>" alt="<%= item.title %>">
                    <% } else { %>
                        <img
                            src="/images/<%= item.category.toLowerCase() === 'wallet' ? 'wallet.jpg' : item.category.toLowerCase() === 'bag' ? 'backpack.jpg' : item.category.toLowerCase() === 'books' ? 'notebook.jpg' : 'backpack.jpg' %>"
                            alt="<%= item.title %>"
                        >
                    <% } %>

                    <span class="details-status <%= item.type.toLowerCase() %>">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <%= item.type %> Item
                    </span>
                </div>

                <div class="details-thumbnails">
                    <div class="thumbnail active">
                        <% if (item.image) { %>
                            <img src="<%= item.image %>" alt="<%= item.title %>">
                        <% } else { %>
                            <img
                                src="/images/<%= item.category.toLowerCase() === 'wallet' ? 'wallet.jpg' : item.category.toLowerCase() === 'bag' ? 'backpack.jpg' : item.category.toLowerCase() === 'books' ? 'notebook.jpg' : 'backpack.jpg' %>"
                                alt="<%= item.title %>"
                            >
                        <% } %>
                    </div>
                </div>

            </div>

            <div class="details-content">

                <div class="details-actions">
                    <button type="button">
                        <i class="bi bi-heart"></i>
                    </button>

                    <button type="button">
                        <i class="bi bi-share"></i>
                    </button>
                </div>

                <span class="details-category">
                    <%= item.category %>
                </span>

                <h1><%= item.title %></h1>

                <p class="details-short-description">
                    <%= item.description %>
                </p>

                <div class="details-line"></div>

                <p class="details-description">
                    <%= item.description %>
                </p>

                <div class="details-info-grid">

                    <div class="details-info-box">
                        <div class="info-icon">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                        <div>
                            <small>Category</small>
                            <strong><%= item.category %></strong>
                        </div>
                    </div>

                    <div class="details-info-box">
                        <div class="info-icon status-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <small>Status</small>
                            <strong><%= item.type %></strong>
                        </div>
                    </div>

                    <div class="details-info-box">
                        <div class="info-icon location-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <small>Location</small>
                            <strong><%= item.location %></strong>
                        </div>
                    </div>

                    <div class="details-info-box">
                        <div class="info-icon date-icon">
                            <i class="bi bi-calendar3"></i>
                        </div>
                        <div>
                            <small>Date Reported</small>
                            <strong><%= item.date.toDateString() %></strong>
                        </div>
                    </div>

                </div>

                <div class="manage-item">

                    <div class="manage-text">
                        <i class="bi bi-gear"></i>
                        <div>
                            <strong>Manage this item</strong>
                            <small>Update the information or remove this report.</small>
                        </div>
                    </div>

                    <div class="manage-buttons">

                        <a href="/items/<%= item._id %>/edit">
                            <i class="bi bi-pencil"></i>
                            Edit Item
                        </a>

                        <form
                            action="/items/<%= item._id %>/delete"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this item?');"
                        >
                            <button type="submit">
                                <i class="bi bi-trash"></i>
                                Delete Item
                            </button>
                        </form>

                    </div>

                </div>

                <div class="found-item">

                    <div>
                        <i class="bi bi-info-circle-fill"></i>
                    </div>

                    <div>
                        <strong>Found this item?</strong>
                        <small>
                            If you have found this item, please contact the person who reported it through the platform.
                        </small>
                    </div>

                    <button type="button">
                        <i class="bi bi-envelope"></i>
                        Contact Reporter
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>