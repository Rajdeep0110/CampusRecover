<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Item Details - CampusRecover</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container mt-5">

        <h1 class="mb-4">Item Details</h1>

        <div class="card">

            <div class="card-body">

                <h2 class="card-title">
                    <%= item.title %>
                </h2>

                <p class="card-text">
                    <strong>Description:</strong>
                    <%= item.description %>
                </p>

                <p class="card-text">
                    <strong>Category:</strong>
                    <%= item.category %>
                </p>

                <p class="card-text">
                    <strong>Type:</strong>
                    <%= item.type %>
                </p>

                <p class="card-text">
                    <strong>Location:</strong>
                    <%= item.location %>
                </p>

                <p class="card-text">
                    <strong>Date:</strong>
                    <%= item.date.toDateString() %>
                </p>

                <a href="/items" class="btn btn-secondary">
                    Back to Items
                </a>

            </div>

        </div>

    </div>

</body>
</html>