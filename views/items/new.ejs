<section class="new-page">

    <div class="container">

        <div class="new-header">

            <div>
                <span class="new-label">REPORT A CAMPUS ITEM</span>

                <h1>
                    Report an <span>Item</span>
                </h1>

                <p>
                    Found something lost or lost something valuable? Report it here to reach your campus community.
                </p>
            </div>

            <div class="new-header-icon">
                <i class="bi bi-plus-circle-fill"></i>
            </div>

        </div>


        <div class="new-card">

            <% if (error) { %>
                <div class="new-error mb-4">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    <%= error %>
                </div>
            <% } %>

            <form
                action="/items"
                method="POST"
                enctype="multipart/form-data"
            >

                <!-- Item Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">
                        Item Title <span class="text-danger">*</span>
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        class="form-control"
                        placeholder="e.g., Black Backpack, Apple AirPods Pro"
                        value="<%= formData && formData.title ? formData.title : '' %>"
                        required
                    >
                </div>


                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">
                        Description <span class="text-danger">*</span>
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        class="form-control"
                        rows="4"
                        placeholder="Provide details such as color, brand, unique identifiers, or specific condition..."
                        required
                    ><%= formData && formData.description ? formData.description : '' %></textarea>
                </div>


                <!-- Grid Row: Category & Status Type -->
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="category" class="form-label">
                            Category <span class="text-danger">*</span>
                        </label>

                        <select
                            id="category"
                            name="category"
                            class="form-select"
                            required
                        >
                            <option value="" disabled <%= !formData || !formData.category ? 'selected' : '' %>>Select a category</option>
                            <option value="Electronics" <%= formData && formData.category === "Electronics" ? "selected" : "" %>>Electronics (Phone, Laptop, Headphones)</option>
                            <option value="Bag" <%= formData && formData.category === "Bag" ? "selected" : "" %>>Bag / Backpack</option>
                            <option value="Books" <%= formData && formData.category === "Books" ? "selected" : "" %>>Books / Notebooks</option>
                            <option value="Wallet" <%= formData && formData.category === "Wallet" ? "selected" : "" %>>Wallet / ID Card</option>
                            <option value="Keys" <%= formData && formData.category === "Keys" ? "selected" : "" %>>Keys</option>
                            <option value="Clothing" <%= formData && formData.category === "Clothing" ? "selected" : "" %>>Clothing / Accessories</option>
                            <option value="Bottle" <%= formData && formData.category === "Bottle" ? "selected" : "" %>>Water Bottle</option>
                            <option value="Other" <%= formData && formData.category === "Other" ? "selected" : "" %>>Other</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="type" class="form-label">
                            Report Status <span class="text-danger">*</span>
                        </label>

                        <select
                            id="type"
                            name="type"
                            class="form-select"
                            required
                        >
                            <option
                                value="Lost"
                                <%= !formData || formData.type === "Lost" ? "selected" : "" %>
                            >
                                Lost (I lost this item)
                            </option>

                            <option
                                value="Found"
                                <%= formData && formData.type === "Found" ? "selected" : "" %>
                            >
                                Found (I found this item)
                            </option>
                        </select>
                    </div>

                </div>


                <!-- Grid Row: Location & Date -->
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="location" class="form-label">
                            Location <span class="text-danger">*</span>
                        </label>

                        <input
                            type="text"
                            id="location"
                            name="location"
                            class="form-control"
                            placeholder="e.g., Central Library - 2nd Floor, Cafeteria"
                            value="<%= formData && formData.location ? formData.location : '' %>"
                            required
                        >
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="date" class="form-label">
                            Date Lost / Found <span class="text-danger">*</span>
                        </label>

                        <input
                            type="date"
                            id="date"
                            name="date"
                            class="form-control"
                            value="<%= formData && formData.date ? formData.date : new Date().toISOString().split('T')[0] %>"
                            required
                        >
                    </div>

                </div>


                <!-- Image File Upload -->
                <div class="mb-4">
                    <label for="image" class="form-label">
                        Image Attachment <span class="text-muted">(Optional)</span>
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="image"
                        class="form-control"
                        accept="image/*"
                    >
                    <div class="form-text">
                        Uploading a photo helps others identify the item much faster. Supported formats: JPG, PNG, JPEG.
                    </div>
                </div>


                <!-- Form Actions -->
                <div class="new-actions">
                    <button type="submit" class="submit-btn">
                        <i class="bi bi-check2-circle me-1"></i>
                        Report Item
                    </button>

                    <a href="/items" class="back-btn ms-2">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Items
                    </a>
                </div>

            </form>

        </div>

    </div>

</section>