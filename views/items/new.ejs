<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Report Item - CampusRecover</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container mt-5">

        <h1 class="mb-4">Report an Item</h1>

        <form
            action="/items"
            method="POST"
            enctype="multipart/form-data"
        >

            <div class="mb-3">

                <label for="title" class="form-label">
                    Item Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    class="form-control"
                    value="<%= formData ? formData.title : '' %>"
                >

                <% if (error) { %>
                    <div class="text-danger mt-2">
                        <%= error %>
                    </div>
                <% } %>

            </div>

            <div class="mb-3">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    class="form-control"
                    rows="4"
                ><%= formData ? formData.description : '' %></textarea>

            </div>

            <div class="mb-3">

                <label for="category" class="form-label">
                    Category
                </label>

                <input
                    type="text"
                    id="category"
                    name="category"
                    class="form-control"
                    value="<%= formData ? formData.category : '' %>"
                >

            </div>

            <div class="mb-3">

                <label for="type" class="form-label">
                    Type
                </label>

                <select
                    id="type"
                    name="type"
                    class="form-select"
                >

                    <option
                        value="Lost"
                        <%= formData && formData.type === "Lost" ? "selected" : "" %>
                    >
                        Lost
                    </option>

                    <option
                        value="Found"
                        <%= formData && formData.type === "Found" ? "selected" : "" %>
                    >
                        Found
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label for="location" class="form-label">
                    Location
                </label>

                <input
                    type="text"
                    id="location"
                    name="location"
                    class="form-control"
                    value="<%= formData ? formData.location : '' %>"
                >

            </div>

            <div class="mb-3">

                <label for="date" class="form-label">
                    Date
                </label>

                <input
                    type="date"
                    id="date"
                    name="date"
                    class="form-control"
                    value="<%= formData ? formData.date : '' %>"
                >

            </div>

            <div class="mb-3">

                <label for="image" class="form-label">
                    Image
                </label>

                <input
                    type="file"
                    id="image"
                    name="image"
                    class="form-control"
                    accept="image/*"
                >

            </div>

            <button type="submit" class="btn btn-primary">
                Report Item
            </button>

            <a href="/items" class="btn btn-secondary ms-2">
                Back to Items
            </a>

        </form>

    </div>

</body>
</html>